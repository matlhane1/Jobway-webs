<!DOCTYPE html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Verify — JobWay</title>
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<style>
body{margin:0;background:#0A1F2E;color:white;display:grid;place-items:center;min-height:100vh;padding:20px;font-family:sans-serif}
.card{max-width:380px;width:100%;background:#1A3341;border-radius:22px;padding:26px;text-align:center;border:2px solid #01F9C6}
input{width:100%;padding:14px;border-radius:12px;background:#0f2332;color:white;font-size:24px;text-align:center;letter-spacing:6px;margin:14px 0;border:1px solid #01F9C6}
button{width:100%;background:#01F9C6;border:none;padding:14px;border-radius:999px;font-weight:900;cursor:pointer;font-size:16px}
</style></head><body>
<div class="card">
<h2>Enter OTP Code</h2>
<p style="color:#8DB0BF;font-size:13px">Code sent to <b id="em" style="color:#01F9C6"></b></p>
<div style="background:#0f2332;padding:12px;border-radius:10px;margin:10px 0">Your Code: <b id="showCode" style="color:#01F9C6;font-size:22px;letter-spacing:3px"></b></div>
<input id="otp" maxlength="6" type="tel" placeholder="000000">
<button id="btn" onclick="verifyNow()">Verify & Create Account →</button>
<p id="msg" style="font-size:13px;margin-top:12px;color:#FF9B9B"></p>
</div>
<script>
const supabase = window.supabase.createClient("https://bzbsqouohsylnhrsjhhy.supabase.co","sb_publishable_4Pu9nggIN-RbVxfHhRpIUg_fR4hfba2");
const email = localStorage.getItem('jobway_otp_email') || new URLSearchParams(location.search).get('email') || '';
const realCode = localStorage.getItem('jobway_otp_code') || new URLSearchParams(location.search).get('code') || '';
document.getElementById('em').innerText = email;
document.getElementById('showCode').innerText = realCode;
document.getElementById('otp').value = realCode;

async function verifyNow(){
  const input = document.getElementById('otp').value.trim();
  const msg = document.getElementById('msg');
  const btn = document.getElementById('btn');
  const saved = localStorage.getItem('jobway_otp_code');
  
  if(input !== saved){
    msg.innerText = '❌ Wrong code. Correct code is: '+saved;
    return;
  }
  
  const pending = JSON.parse(localStorage.getItem('jobway_pending_signup')||'null');
  if(!pending){ msg.innerText='Session expired. Signup again'; return; }
  
  btn.disabled=true; btn.innerText='Creating account...'; msg.style.color='#01F9C6'; msg.innerText='✅ Code correct! Creating your account...';
  
  try{
    const {error} = await supabase.auth.signUp({
      email: pending.email,
      password: pending.password,
      options:{ data:{ full_name: pending.full_name, role: pending.role } }
    });
    if(error && !error.message.toLowerCase().includes('already')) throw error;
    
    const {error: loginErr} = await supabase.auth.signInWithPassword({email: pending.email, password: pending.password});
    if(loginErr){ msg.innerText='✅ Verified! Please login now'; setTimeout(()=>location.href='login.html',1000); return; }
    
    localStorage.setItem('jobway_user_email', pending.email);
    localStorage.setItem('user_role', pending.role);
    msg.innerText='✅ Account created! Redirecting...';
    setTimeout(()=>{ location.href='employer-dashboard.html'; }, 1000);
  }catch(e){
    msg.style.color='#FF9B9B';
    msg.innerText='Error: '+e.message;
    btn.disabled=false; btn.innerText='Verify & Create Account →';
  }
}
</script></body></html>
