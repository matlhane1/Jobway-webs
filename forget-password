<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Forgot Password | JobWay</title>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@600;700;800&family=Space+Grotesk:wght@700;800&display=swap" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<style>
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:'Plus Jakarta Sans',sans-serif;background:#0F2230;color:white;min-height:100vh;display:flex;flex-direction:column}
.header{background:#11283A;padding:12px 16px;display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid #1E3A4A}
.logo{font-weight:900;color:#01F9C6;font-size:20px;font-family:'Space Grotesk',sans-serif}
.btn{border:none;border-radius:999px;padding:10px 16px;font-weight:800;cursor:pointer;font-size:13px;white-space:nowrap}
.btn-dark{background:#2A3F4E;color:white}.btn-green{background:#01F9C6;color:#08231C}
.nav-cta{display:flex;flex-direction:row;gap:8px;align-items:center}
.container{max-width:420px;margin:40px auto;padding:16px;width:100%}
.card{background:#1A3341;border:1px solid #25475A;border-radius:20px;padding:22px}
.input{width:100%;background:#0F2230;border:1px solid #25475A;color:white;padding:14px;border-radius:12px;margin-top:10px;font-family:'Plus Jakarta Sans',sans-serif}
.input:focus{border-color:#01F9C6;outline:none}
.btn-submit{width:100%;background:#01F9C6;color:#08231C;border:none;border-radius:999px;padding:14px;font-weight:900;margin-top:16px;cursor:pointer}
.banner{background:linear-gradient(135deg,#01F9C6,#30BA8F);color:#08231C;border-radius:12px;padding:12px;font-weight:800;font-size:12px;text-align:center;margin-bottom:14px}
</style>
</head>
<body>
<div class="header">
<div class="logo">JobWay</div>
<div class="nav-cta">
<button class="btn btn-dark" onclick="location.href='pricing.html'">Pricing</button>
<button class="btn btn-dark" onclick="location.href='jobs.html'">💼 Jobs</button>
<button class="btn btn-dark" onclick="location.href='login.html'">Log In</button>
</div>
</div>

<div class="container">
<div class="card">
<h2 style="font-family:'Space Grotesk',sans-serif;font-weight:800">Forgot Password?</h2>
<p style="color:#8DB0BF;font-size:12px;margin-top:6px">Enter email and we will send reset link from <b style="color:#01F9C6">no-reply@jobway.co.za</b></p>
<input class="input" id="email" type="email" placeholder="you@gmail.com">
<button class="btn-submit" id="sendBtn" onclick="sendReset()">📧 Send Reset Link</button>
<div id="msg" style="margin-top:12px;font-size:12px;text-align:center;color:#8DB0BF"></div>
<div id="success" class="banner" style="display:none;margin-top:14px">✅ Email sent from no-reply@jobway.co.za - Check inbox + spam</div>
<p style="text-align:center;margin-top:14px"><a href="login.html" style="color:#01F9C6;font-size:12px;font-weight:700">← Back to Login</a></p>
</div>
</div>

<script>
const supabaseClient = window.supabase.createClient("https://dmxumcjeetphwzvgzzuk.supabase.co","sb_publishable_AU4KIOG0oHh5NLK7hv1iEg_oYIrIM3-");
async function sendReset(){
  const email = document.getElementById('email').value.trim();
  if(!email){ alert('Enter email'); return; }
  const btn = document.getElementById('sendBtn'); btn.textContent='Sending...'; btn.disabled=true;
  document.getElementById('msg').innerText='Sending from no-reply@jobway.co.za...';
  const { error } = await supabaseClient.auth.resetPasswordForEmail(email, {
    redirectTo: 'https://jobway.co.za/reset-password.html'
  });
  if(error){ document.getElementById('msg').innerText='❌ '+error.message; btn.textContent='📧 Send Reset Link'; btn.disabled=false; return; }
  document.getElementById('msg').innerText=''; document.getElementById('success').style.display='block'; btn.textContent='✅ Sent!';
}
</script>
</body>
</html>
